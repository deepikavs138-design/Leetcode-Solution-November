class Solution {
public:
    long long minOperations(vector<int>& nums, int x, int k) {
        int n = nums.size();

        vector<long long> cost(n - x + 1);

        multiset<int> lo, hi;
        long long sumLo = 0, sumHi = 0;

        auto balance = [&]() {
            while (lo.size() > hi.size() + 1) {
                auto it = prev(lo.end());
                int v = *it;
                lo.erase(it);
                sumLo -= v;

                hi.insert(v);
                sumHi += v;
            }

            while (lo.size() < hi.size()) {
                auto it = hi.begin();
                int v = *it;
                hi.erase(it);
                sumHi -= v;

                lo.insert(v);
                sumLo += v;
            }
        };

        auto add = [&](int v) {
            if (lo.empty() || v <= *prev(lo.end())) {
                lo.insert(v);
                sumLo += v;
            } else {
                hi.insert(v);
                sumHi += v;
            }
            balance();
        };

        auto remove = [&](int v) {
            auto it = lo.find(v);

            if (it != lo.end()) {
                lo.erase(it);
                sumLo -= v;
            } else {
                it = hi.find(v);
                hi.erase(it);
                sumHi -= v;
            }

            balance();
        };

        for (int i = 0; i < x; i++)
            add(nums[i]);

        auto getCost = [&]() -> long long {
            long long med = *prev(lo.end());

            return med * (long long)lo.size() - sumLo +
                   sumHi - med * (long long)hi.size();
        };

        cost[0] = getCost();

        for (int i = x; i < n; i++) {
            add(nums[i]);
            remove(nums[i - x]);

            cost[i - x + 1] = getCost();
        }

        const long long INF = 4e18;

        vector<vector<long long>> dp(
            n + 1,
            vector<long long>(k + 1, INF));

        dp[0][0] = 0;

        for (int i = 0; i < n; i++) {
            for (int j = 0; j <= k; j++) {
                if (dp[i][j] == INF)
                    continue;

                dp[i + 1][j] =
                    min(dp[i + 1][j], dp[i][j]);

                if (j < k && i + x <= n) {
                    dp[i + x][j + 1] =
                        min(dp[i + x][j + 1],
                            dp[i][j] + cost[i]);
                }
            }
        }

        long long ans = INF;

        for (int i = 0; i <= n; i++)
            ans = min(ans, dp[i][k]);

        return ans;
    }
};
