#include <algorithm>
#include <numeric>
#include <vector>

using namespace std;

class Solution {
public:
    int maxLength(vector<int>& nums) {
        int n = static_cast<int>(nums.size());
        int ans = 0;

        for (int i = 0; i < n; ++i) {
            long long prod = 1;
            long long g = 0;
            long long l = 1;

            for (int j = i; j < n; ++j) {
                long long x = nums[j];
                prod *= x;
                g = std::gcd(g, x);
                l = std::lcm(l, x);

                // Stop expanding if prod already exceeds the maximum possible LCM * GCD
                // (max lcm for elements <= 10 is 2520, and gcd >= 1)
                if (prod > 2520LL * 10LL) {
                    break;
                }

                if (prod == l * g) {
                    ans = max(ans, j - i + 1);
                }
            }
        }

        return ans;
    }
};
