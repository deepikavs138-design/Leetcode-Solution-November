#include <string>
#include <iostream>

class Solution {
public:
    string digitSum(string s, int k) {
        while (s.length() > k) {
            string next_s = "";
            for (int i = 0; i < s.length(); i += k) {
                string group = s.substr(i, k);
                int current_sum = 0;
                for (char c : group) {
                    current_sum += c - '0';
                }
                next_s += std::to_string(current_sum);
            }
            s = next_s;
        }
        return s;
    }
};
